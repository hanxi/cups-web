CUPSADMIN=print
CUPSPASSWORD=print
TZ=Asia/Shanghai

# 仅 Web 镜像：TCP 模式填写已有 CUPS 服务的地址和端口。
# CUPS_HOST=192.168.1.100:631

# Unix Socket 模式优先于 CUPS_HOST，填写 Web 容器内的绝对路径，需挂载运行目录。
# CUPS_SOCKET_PATH=/var/run/cups/cups.sock
# 使用 docker-compose.web.socket.yml 时，宿主机运行目录默认 /var/run/cups。
# CUPS_SOCKET_DIR=/var/run/cups

# 扫描设备发现缓存有效期（Go duration 格式，默认 60s）。
# scanimage -L 需约 17s，设备固定时可调大（如 24h）避免切页重复等待；
# 插拔或更换扫描仪后点页面「刷新」即可强制重新枚举。
# SCAN_DEVICES_CACHE_TTL=24h
